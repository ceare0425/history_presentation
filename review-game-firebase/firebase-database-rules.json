{
  "rules": {
    "rooms": {
      "$room": {
        "questions": {
          ".read": true,
          ".write": true
        },
        "round": {
          ".read": true,
          ".write": true
        },
        "players": {
          ".read": true,
          "$playerId": {
            ".write": true,
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        }
      }
    }
  }
}
