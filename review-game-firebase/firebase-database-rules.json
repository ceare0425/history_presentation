{
  "rules": {
    "rooms": {
      "$room": {
        "questions": {
          ".read": true,
          ".write": true
        },
        "round": {
          ".read": true,
          ".write": true
        },
        "item_events": {
          ".read": true,
          ".write": true,
          "$evt": {
            ".validate": "!newData.exists() || (newData.hasChild('type') && newData.hasChild('at'))"
          }
        },
        "players": {
          ".read": true,
          "$playerId": {
            ".write": true,
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "solo_log": {
          ".read": true,
          ".write": true,
          "$entry": {
            ".validate": "!newData.exists() || (newData.hasChild('name') && newData.hasChild('ts') && newData.child('name').val().length <= 20)"
          }
        },
        "class_log": {
          ".read": true,
          ".write": true,
          "$entry": {
            ".validate": "!newData.exists() || (newData.hasChild('name') && newData.hasChild('ts') && newData.child('name').val().length <= 20)"
          }
        }
      }
    },
    "roster": {
      ".read": true,
      "$key": {
        ".write": true
      }
    },
    "presence": {
      ".read": true,
      "$room": {
        "$classKey": {
          "$name": {
            ".write": true
          }
        }
      }
    },
    "messages": {
      ".read": true,
      "$room": {
        "$classKey": {
          "$name": {
            "$msgId": {
              ".write": true,
              ".validate": "newData.hasChild('from') && newData.hasChild('text') && newData.hasChild('ts') && newData.child('text').val().length <= 300"
            }
          }
        }
      }
    },
    "museum": {
      ".read": true,
      "$tour": {
        "students": {
          "$sid": {
            ".write": true,
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "reviews": {
          ".write": true
        },
        "photos": {
          ".write": true
        }
      }
    }
  }
}
