#!/bin/sh
# 커밋할 때마다 스테이징된 HTML/JS의 자바스크립트 문법을 검사하고, 오류가 있으면 커밋을 막는다.
# 설치: git config core.hooksPath .githooks   (저장소마다 한 번)
# 검사 도구: tools/check_js_syntax.py  (필요: python -m pip install esprima)

ROOT=$(git rev-parse --show-toplevel)
if command -v python >/dev/null 2>&1; then PY=python
elif command -v python3 >/dev/null 2>&1; then PY=python3
else
  echo "[문법 검사] 파이썬을 찾을 수 없어 커밋을 막았습니다. 파이썬을 설치하세요."
  exit 1
fi

exec "$PY" "$ROOT/tools/check_js_syntax.py"
